{
  "name": "domino-multiplayer-workspace",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "postinstall": "npm run install:all",
    "install:all": "npm install --prefix client && npm install --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client:dev": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run install:all && npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "test": "npm test --prefix server"
  }
}
